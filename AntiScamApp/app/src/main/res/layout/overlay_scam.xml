<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6D32F2F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="72sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCAM DETECTED!"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- ML Risk Score -->
        <TextView
            android:id="@+id/tv_risk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Risk Score: 0%"
            android:textColor="#FFEB3B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DO NOT ENTER YOUR UPI PIN\n\nOur AI model detected a fraudulent\npayment request on your screen."
            android:textColor="@color/white"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- BLOCK BUTTON — red with white text, prominent -->
        <Button
            android:id="@+id/btn_block"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:text="🛡️  BLOCK &amp; GO HOME"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#B71C1C"
            android:layout_marginBottom="16dp"
            android:elevation="4dp" />

        <!-- Hold-to-dismiss label -->
        <TextView
            android:id="@+id/tv_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Touch &amp; hold to dismiss"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="12dp" />

    </LinearLayout>

</FrameLayout>
